@@ -0,0 +1,257 @@
+//! Linux-only bounded research runner. All modes retain two full 2 GiB arenas;
+//! timings exclude allocation/address precomputation and include completed work.
+#[cfg(target_os = "linux")]
+mod linux {
+    use argon2::{Algorithm, Argon2, Params, Version};
+    use blocknet_pow_kernel::{CpuKernel, FixedArgon2id, PowBlock};
+    use std::hint::black_box;
+    use std::time::{Duration, Instant};
+
+    const MEMORY_KIB: u32 = 2 * 1024 * 1024;
+    const SALT: &[u8] = b"interhash-full-size";
+
+    struct Arena {
+        ptr: *mut PowBlock,
+        bytes: usize,
+    }
+
+    // The mapping has one owner, moves to at most one worker, and is never shared.
+    unsafe impl Send for Arena {}
+
+    impl Arena {
+        fn new(large: bool) -> Self {
+            let bytes = MEMORY_KIB as usize * 1024;
+            let flags = libc::MAP_PRIVATE
+                | libc::MAP_ANONYMOUS
+                | if large {
+                    libc::MAP_HUGETLB | libc::MAP_HUGE_2MB
+                } else {
+                    0
+                };
+            let raw = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    bytes,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    flags,
+                    -1,
+                    0,
+                )
+            };
+            assert_ne!(
+                raw,
+                libc::MAP_FAILED,
+                "arena mmap: {}",
+                std::io::Error::last_os_error()
+            );
+            if !large {
+                assert_eq!(
+                    unsafe { libc::madvise(raw, bytes, libc::MADV_NOHUGEPAGE) },
+                    0
+                );
+            }
+            Self {
+                ptr: raw.cast(),
+                bytes,
+            }
+        }
+
+        fn blocks(&mut self) -> &mut [PowBlock] {
+            assert_eq!(std::mem::size_of::<PowBlock>(), 1024);
+            // Anonymous mappings are zeroed and all bit patterns are valid PowBlocks.
+            unsafe { std::slice::from_raw_parts_mut(self.ptr, MEMORY_KIB as usize) }
+        }
+    }
+
+    impl Drop for Arena {
+        fn drop(&mut self) {
+            assert_eq!(unsafe { libc::munmap(self.ptr.cast(), self.bytes) }, 0);
+        }
+    }
+
+    fn pin(cpu: usize) {
+        assert!(cpu < libc::CPU_SETSIZE as usize);
+        let mut set = unsafe { std::mem::zeroed::<libc::cpu_set_t>() };
+        unsafe { libc::CPU_SET(cpu, &mut set) };
+        assert_eq!(
+            unsafe { libc::sched_setaffinity(0, std::mem::size_of_val(&set), &set) },
+            0
+        );
+    }
+
+    fn pair(
+        mode: &str,
+        hasher: &FixedArgon2id,
+        nonce: u64,
+        left: &mut Arena,
+        right: &mut Arena,
+    ) -> [[u8; 32]; 2] {
+        let a = nonce.to_le_bytes();
+        let b = nonce.wrapping_add(1).to_le_bytes();
+        let mut output = [[0u8; 32]; 2];
+        match mode {
+            "pair1" => hasher
+                .hash_pair_interleaved::<1>(
+                    [&a, &b],
+                    SALT,
+                    &mut output,
+                    left.blocks(),
+                    right.blocks(),
+                )
+                .unwrap(),
+            "pair4" => hasher
+                .hash_pair_interleaved::<4>(
+                    [&a, &b],
+                    SALT,
+                    &mut output,
+                    left.blocks(),
+                    right.blocks(),
+                )
+                .unwrap(),
+            "pair16" => hasher
+                .hash_pair_interleaved::<16>(
+                    [&a, &b],
+                    SALT,
+                    &mut output,
+                    left.blocks(),
+                    right.blocks(),
+                )
+                .unwrap(),
+            "sequential" => {
+                hasher
+                    .hash_password_into_with_memory(&a, SALT, &mut output[0], left.blocks())
+                    .unwrap();
+                hasher
+                    .hash_password_into_with_memory(&b, SALT, &mut output[1], right.blocks())
+                    .unwrap();
+            }
+            _ => panic!("unknown pair mode"),
+        }
+        output
+    }
+
+    fn verify(kernel: CpuKernel, large: bool) {
+        // Compute references before retaining the two candidate arenas: peak is 4 GiB.
+        let reference = Argon2::new(
+            Algorithm::Argon2id,
+            Version::V0x13,
+            Params::new(MEMORY_KIB, 1, 1, Some(32)).unwrap(),
+        );
+        let mut expected = Vec::new();
+        for nonce in [0u64, 12345, u64::MAX - 1] {
+            let mut outputs = [[0u8; 32]; 2];
+            for (offset, output) in outputs.iter_mut().enumerate() {
+                reference
+                    .hash_password_into(
+                        &nonce.wrapping_add(offset as u64).to_le_bytes(),
+                        SALT,
+                        output,
+                    )
+                    .unwrap();
+            }
+            expected.push((nonce, outputs));
+        }
+        let hasher = FixedArgon2id::with_kernel(MEMORY_KIB, kernel).unwrap();
+        let mut left = Arena::new(large);
+        let mut right = Arena::new(large);
+        for mode in ["sequential", "pair1", "pair4", "pair16"] {
+            for (nonce, outputs) in &expected {
+                assert_eq!(
+                    pair(mode, &hasher, *nonce, &mut left, &mut right),
+                    *outputs,
+                    "full-size reference parity: kernel={kernel},mode={mode},nonce={nonce}"
+                );
+                println!("PASS kernel={kernel} mode={mode} nonce={nonce} memory_kib={MEMORY_KIB} dirty_reuse=true");
+            }
+        }
+    }
+
+    pub fn main() {
+        let args: Vec<_> = std::env::args().collect();
+        assert_eq!(
+            args.len(),
+            7,
+            "usage: interhash_experiment MODE KERNEL PAGE SECONDS CPU0 CPU1"
+        );
+        let mode = &args[1];
+        let kernel: CpuKernel = args[2].parse().unwrap();
+        assert!(matches!(args[3].as_str(), "regular" | "large"));
+        let large = args[3] == "large";
+        let seconds: u64 = args[4].parse().unwrap();
+        assert!((1..=120).contains(&seconds));
+        let cpu0: usize = args[5].parse().unwrap();
+        let cpu1: usize = args[6].parse().unwrap();
+        pin(cpu0);
+        if mode == "verify" {
+            verify(kernel, large);
+            return;
+        }
+        let hasher = FixedArgon2id::with_kernel(MEMORY_KIB, kernel).unwrap();
+        let mut left = Arena::new(large);
+        let mut right = Arena::new(large);
+        let warm = pair("sequential", &hasher, 0, &mut left, &mut right);
+        black_box(warm);
+        let (hashes, elapsed) = if mode == "workers" {
+            let barrier = std::sync::Barrier::new(3);
+            let start = std::sync::OnceLock::new();
+            let results = std::thread::scope(|scope| {
+                let mut handles = Vec::new();
+                for (lane, (mut arena, cpu)) in
+                    [(left, cpu0), (right, cpu1)].into_iter().enumerate()
+                {
+                    let barrier = &barrier;
+                    let start = &start;
+                    let hasher = &hasher;
+                    handles.push(scope.spawn(move || {
+                        pin(cpu);
+                        barrier.wait();
+                        let begin: Instant = *start.get().unwrap();
+                        let mut completed = 0u64;
+                        while begin.elapsed() < Duration::from_secs(seconds) {
+                            let nonce = completed * 2 + lane as u64 + 2;
+                            let mut output = [0u8; 32];
+                            hasher
+                                .hash_password_into_with_memory(
+                                    &nonce.to_le_bytes(),
+                                    SALT,
+                                    &mut output,
+                                    arena.blocks(),
+                                )
+                                .unwrap();
+                            black_box(output);
+                            completed += 1;
+                        }
+                        (completed, begin.elapsed().as_secs_f64())
+                    }));
+                }
+                start.set(Instant::now()).unwrap();
+                barrier.wait();
+                handles
+                    .into_iter()
+                    .map(|h| h.join().unwrap())
+                    .collect::<Vec<_>>()
+            });
+            (
+                results.iter().map(|r| r.0).sum(),
+                results.iter().map(|r| r.1).fold(0.0, f64::max),
+            )
+        } else {
+            let start = Instant::now();
+            let mut completed = 0;
+            while start.elapsed() < Duration::from_secs(seconds) {
+                black_box(pair(mode, &hasher, completed + 2, &mut left, &mut right));
+                completed += 2;
+            }
+            (completed, start.elapsed().as_secs_f64())
+        };
+        println!("{{\"mode\":\"{mode}\",\"kernel\":\"{kernel}\",\"page\":\"{}\",\"cpu0\":{cpu0},\"cpu1\":{cpu1},\"arena_bytes\":4294967296,\"hashes\":{hashes},\"elapsed_secs\":{elapsed:.9},\"completed_hps\":{:.9}}}",
+        args[3], hashes as f64 / elapsed);
+    }
+}
+
+fn main() {
+    #[cfg(target_os = "linux")]
+    linux::main();
+    #[cfg(not(target_os = "linux"))]
+    panic!("this research runner requires Linux mmap and hard CPU affinity");
+}
