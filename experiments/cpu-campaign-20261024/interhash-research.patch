+++ b/pow-kernel/src/fixed_argon/interhash.rs
@@ -0,0 +1,187 @@
+//! Research only: two independent full-size hashes on one core. The ordinary
+//! data-independent phase is unchanged; only data-dependent blocks interleave.
+//! This avoids doubling the already-prefetched DI loop's instruction footprint.
+use super::*;
+
+impl FixedArgon2id {
+    /// Experimental scheduling, never selected by the miner or default features.
+    /// Both arenas retain the full consensus memory requirement independently.
+    pub fn hash_pair_interleaved<const CHUNK: usize>(
+        &self,
+        passwords: [&[u8]; 2],
+        salt: &[u8],
+        outputs: &mut [[u8; 32]; 2],
+        left: &mut [PowBlock],
+        right: &mut [PowBlock],
+    ) -> Result<()> {
+        assert!(CHUNK > 0 && CHUNK <= 64);
+        for (password, output) in passwords.iter().zip(outputs.iter()) {
+            verify_inputs(password, salt, output)?;
+        }
+        let left = left
+            .get_mut(..self.block_count)
+            .ok_or(Error::MemoryTooLittle)?;
+        let right = right
+            .get_mut(..self.block_count)
+            .ok_or(Error::MemoryTooLittle)?;
+        for (lane, memory) in [&mut *left, &mut *right].into_iter().enumerate() {
+            initialize_lane_blocks(
+                memory,
+                initial_hash(
+                    self.requested_memory_kib,
+                    ARGON2_T_COST,
+                    ARGON2_LANES,
+                    passwords[lane],
+                    salt,
+                    &outputs[lane],
+                ),
+            )?;
+        }
+        match self.isa {
+            ISA_AVX2 => self.fill_pair::<ISA_AVX2, CHUNK>(left, right),
+            ISA_AVX512 => self.fill_pair::<ISA_AVX512, CHUNK>(left, right),
+            ISA_AVX512_256 => self.fill_pair::<ISA_AVX512_256, CHUNK>(left, right),
+            ISA_NEON => self.fill_pair::<ISA_NEON, CHUNK>(left, right),
+            _ => self.fill_pair::<ISA_SCALAR, CHUNK>(left, right),
+        }
+        finalize(left, &mut outputs[0])?;
+        finalize(right, &mut outputs[1])
+    }
+
+    fn fill_pair<const ISA: u8, const CHUNK: usize>(
+        &self,
+        left: &mut [PowBlock],
+        right: &mut [PowBlock],
+    ) {
+        // Both sequential DI phases use the baseline distance-three prefetch.
+        for memory in [&mut *left, &mut *right] {
+            for slice in 0..2 {
+                let first = if slice == 0 { 2 } else { 0 };
+                let base = slice * self.segment_length;
+                for pre in first..(first + 3).min(self.segment_length) {
+                    prefetch_pow_block(&memory[self.data_independent_ref_indexes[base + pre]]);
+                }
+                for block in first..self.segment_length {
+                    if block + 3 < self.segment_length {
+                        prefetch_pow_block(
+                            &memory[self.data_independent_ref_indexes[base + block + 3]],
+                        );
+                    }
+                    let current = base + block;
+                    fill_block_from_refs::<ISA>(
+                        memory,
+                        current - 1,
+                        self.data_independent_ref_indexes[current],
+                        current,
+                    );
+                }
+            }
+        }
+        for slice in 2..SYNC_POINTS {
+            let base = slice * self.segment_length;
+            for block in (0..self.segment_length).step_by(CHUNK) {
+                let current = base + block;
+                // Expose both upcoming references before doing either chain.
+                for memory in [&*left, &*right] {
+                    let reference = reference_index(current - 1, memory[current - 1].as_ref()[0]);
+                    prefetch_pow_block(&memory[reference]);
+                }
+                for memory in [&mut *left, &mut *right] {
+                    for offset in block..(block + CHUNK).min(self.segment_length) {
+                        let current = base + offset;
+                        let reference =
+                            reference_index(current - 1, memory[current - 1].as_ref()[0]);
+                        if offset + 1 < self.segment_length {
+                            #[cfg(target_arch = "x86_64")]
+                            if ISA == ISA_AVX2 || ISA == ISA_AVX512 || ISA == ISA_AVX512_256 {
+                                fill_block_from_refs_mid_prefetch::<ISA>(
+                                    memory,
+                                    current - 1,
+                                    reference,
+                                    current,
+                                    current,
+                                );
+                                continue;
+                            }
+                            #[cfg(target_arch = "aarch64")]
+                            if ISA == ISA_NEON {
+                                fill_block_from_refs_mid_prefetch(
+                                    memory,
+                                    current - 1,
+                                    reference,
+                                    current,
+                                    current,
+                                );
+                                continue;
+                            }
+                        }
+                        fill_block_from_refs::<ISA>(memory, current - 1, reference, current);
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use argon2::{Algorithm, Argon2, Params, Version};
+
+    #[test]
+    fn pair_matches_reference_at_slice_boundaries_and_dirty_reuse() {
+        for memory in [8, 12, 32, 68, 128, 1024] {
+            let mut left = vec![PowBlock::default(); memory as usize];
+            let mut right = left.clone();
+            for kernel in CpuKernel::ALL.into_iter().filter(|k| k.is_supported()) {
+                let hasher = FixedArgon2id::with_kernel(memory, kernel).unwrap();
+                for nonce in 0u64..3 {
+                    let a = nonce.to_le_bytes();
+                    let b = (nonce + 100).to_le_bytes();
+                    let salt = b"interhash-experiment";
+                    let mut expected = [[0u8; 32]; 2];
+                    for (password, out) in [&a, &b].into_iter().zip(&mut expected) {
+                        Argon2::new(
+                            Algorithm::Argon2id,
+                            Version::V0x13,
+                            Params::new(memory, 1, 1, Some(32)).unwrap(),
+                        )
+                        .hash_password_into(password, salt, out)
+                        .unwrap();
+                    }
+                    for chunk in [1, 4, 16] {
+                        let mut actual = [[0u8; 32]; 2];
+                        match chunk {
+                            1 => hasher.hash_pair_interleaved::<1>(
+                                [&a, &b],
+                                salt,
+                                &mut actual,
+                                &mut left,
+                                &mut right,
+                            ),
+                            4 => hasher.hash_pair_interleaved::<4>(
+                                [&a, &b],
+                                salt,
+                                &mut actual,
+                                &mut left,
+                                &mut right,
+                            ),
+                            _ => hasher.hash_pair_interleaved::<16>(
+                                [&a, &b],
+                                salt,
+                                &mut actual,
+                                &mut left,
+                                &mut right,
+                            ),
+                        }
+                        .unwrap();
+                        assert_eq!(
+                            actual, expected,
+                            "kernel={kernel},memory={memory},chunk={chunk},nonce={nonce}"
+                        );
+                    }
+                }
+            }
+        }
+    }
+}
