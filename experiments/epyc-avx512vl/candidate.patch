+    cc = avx2_blamka(cc, dd);
+    bb = _mm256_ror_epi64::<24>(_mm256_xor_si256(bb, cc));
+    *a = avx2_blamka(*a, bb);
+    dd = _mm256_ror_epi64::<16>(_mm256_xor_si256(dd, *a));
+    cc = avx2_blamka(cc, dd);
+    bb = _mm256_ror_epi64::<63>(_mm256_xor_si256(bb, cc));
