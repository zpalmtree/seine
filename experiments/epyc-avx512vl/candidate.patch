+unsafe fn avx512vl_round(
+    a: &mut std::arch::x86_64::__m256i,
+    b: &mut std::arch::x86_64::__m256i,
+    c: &mut std::arch::x86_64::__m256i,
+    d: &mut std::arch::x86_64::__m256i,
